# claude-seo bundles a Chromium download into the skill directory at runtime.
# It is a machine-local cache (~500MB) and must never be committed.
.claude/skills/seo/ms-playwright/
.claude/skills/*/ms-playwright/

# Isolated Python runtime created by `/seo setup`
.claude/skills/seo/.venv/
.claude/skills/*/.venv/
__pycache__/
*.pyc

# Local SEO run artifacts (drift baselines, cached API responses)
.claude/skills/seo/.cache/
.claude/skills/*/.cache/
