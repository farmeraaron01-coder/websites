{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": "https://californiafloodinsurance.com/california-flood-insurance-cost-by-zone/#dataset",
  "name": "California flood insurance median annual cost by FEMA flood zone (2025-2026)",
  "description": "Median annual all-in flood insurance cost for California residential properties, broken out by FEMA flood zone. Derived from 763 new-business policies bound by California Flood Insurance between February 2025 and August 2026, counted one per property. All-in cost includes premium, policy fee, and California surplus lines taxes and fees.",
  "url": "https://californiafloodinsurance.com/california-flood-insurance-cost-by-zone/",
  "isAccessibleForFree": true,
  "inLanguage": "en-US",
  "temporalCoverage": "2025-02/2026-08",
  "spatialCoverage": {
    "@type": "State",
    "name": "California",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "CA",
      "addressCountry": "US"
    }
  },
  "creator": { "@id": "https://californiafloodinsurance.com/#organization" },
  "publisher": { "@id": "https://californiafloodinsurance.com/#organization" },
  "isPartOf": { "@id": "https://californiafloodinsurance.com/california-flood-insurance-cost-by-zone/#webpage" },
  "measurementTechnique": "Median of all-in annual cost (premium, policy fee, surplus lines taxes and fees) across new-business policies bound by California Flood Insurance, grouped by the FEMA flood zone recorded on each policy, deduplicated to one policy per property.",
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "FEMA flood zone",
      "description": "FEMA Flood Insurance Rate Map zone designation recorded on the policy."
    },
    {
      "@type": "PropertyValue",
      "name": "Median annual all-in cost",
      "description": "Median annual cost including premium, policy fee, and California surplus lines taxes and fees.",
      "unitText": "USD per year"
    },
    {
      "@type": "PropertyValue",
      "name": "Policies bound",
      "description": "Number of new-business policies in the sample for that zone, one per property."
    }
  ],
  "distribution": {
    "@type": "DataDownload",
    "encodingFormat": "text/html",
    "contentUrl": "https://californiafloodinsurance.com/california-flood-insurance-cost-by-zone/#california-flood-insurance-costs-by-zone-2025-2026"
  },
  "hasPart": [
    { "@type": "PropertyValue", "name": "Zone AE", "value": 722, "unitCode": "USD", "description": "High risk, mandatory. 375 policies. Typical range $574-$877." },
    { "@type": "PropertyValue", "name": "Zone X", "value": 509, "unitCode": "USD", "description": "Low risk, optional. 101 policies. Typical range $464-$702." },
    { "@type": "PropertyValue", "name": "Zone A", "value": 588, "unitCode": "USD", "description": "High risk, mandatory. 117 policies. Typical range $464-$764." },
    { "@type": "PropertyValue", "name": "Zone AO", "value": 569, "unitCode": "USD", "description": "High risk shallow flooding, mandatory. 114 policies. Typical range $464-$719." },
    { "@type": "PropertyValue", "name": "Zone AH", "value": 733, "unitCode": "USD", "description": "High risk shallow flooding, depth mapped, mandatory. 30 policies. Typical range $542-$1,010." },
    { "@type": "PropertyValue", "name": "Zones A1-A30 (legacy numbered)", "value": 623, "unitCode": "USD", "description": "High risk on older maps, mandatory. 22 policies. Typical range $499-$847." }
  ]
}
